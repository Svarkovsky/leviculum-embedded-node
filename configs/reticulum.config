# ==============================================================================
# reticulum.config - Reticulum Network Interfaces & Transport Configuration
# ==============================================================================
# Place this file in: /tmp/mnt/sda1/home/lblogd/.reticulum/config
#
# The `lnsd` program searches for this file inside the `.reticulum` directory 
# located in the user's HOME directory. Our startup script sets the HOME 
# environment variable to `/tmp/mnt/sda1/home/lblogd`, so it looks for the 
# configuration file at `/tmp/mnt/sda1/home/lblogd/.reticulum/config`.
# ==============================================================================

[reticulum]
# Enable packet routing and transport forwarding on this node
enable_transport = yes

# Share this instance with other local applications on the router
share_instance = yes
shared_instance_port = 37428

# Directory where Reticulum stores its active network state (keys, ratchets, etc.)
# Moved to USB storage to make the database persistent and save ~3.5 MB of RAM!
storagepath = /tmp/mnt/sda1/home/lblogd/reticulum/storage

# Flush interval in seconds to write cached routes and hashes from RAM to disk.
# Reduced to 15 minutes (900 seconds) to prevent memory fragmentation on low-RAM routers.
flush_interval = 900

[logging]
# Log level: 1 (Info), 2 (Warning), 3 (Error), 0 (Debug)
loglevel = 1

[interfaces]
  # Expose Reticulum transport to your local home network (Wi-Fi/LAN)
  [[Local Wi-Fi Server]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 0.0.0.0
    listen_port = 4242

  # Connect to the global I2P network using the socat SAM bridge (Optional)
  # Delegates heavy cryptographic operations to an external or local I2P router (e.g. i2pd).
  [[I2P Bridge Interface]]
    type = I2PInterface
    reconnect_wait = 120
    enabled = yes
    sam_host = 127.0.0.1
    sam_port = 7656
    
    # 5 reliable public I2P bootstrap hubs for Reticulum (comma-separated string format)
    peers = g3br23bvx3lq5uddcsjii74xgmn6y5q325ovrkq2zw2wbzbqgbuq.b32.i2p, 3amqekrikkrvfoyor75tjnlxmswmxiprqx7wknrwsnb46x7kjwuq.b32.i2p, uwafw2ibzgbk5wteqvcip65mtzatjckzo5avfur7vg5asg47oxkq.b32.i2p, wnbroeyo5kotdkq4qpitosoch4f64fiwv4uyrk7tp57w2ubthatq.b32.i2p, fc22dfljkpt2beq3itqjkz2k7oizuythif7aa3m73okq7mqrg66q.b32.i2p
    
    # ==========================================================================
    # YOUR PERSONAL I2P ADDRESS (reachable_on)
    # ==========================================================================
    # To allow other nodes to connect directly to your node over I2P:
    # 1. Start lnsd for the first time. It will register a destination via I2P.
    # 2. Open lnsd.log and locate your b32.i2p address (it looks like a long hash
    #    ending with .b32.i2p).
    # 3. Uncomment the line below and replace the placeholder with your address.
    # ==========================================================================
    # reachable_on = <YOUR_I2P_ADDRESS_FROM_LOGS>.b32.i2p

  # Connect to the WDGWars public Reticulum node over TCP
  [[WDGWars Node]]
    type = TCPClientInterface
    enabled = yes
    target_host = rns.wdgwars.pl
    target_port = 4242
    bootstrap_only = no
    name = WDGWars Node
  
  # Connect to gameboloto.fun public Reticulum backbone node
  [[gameboloto.fun]]
    type = BackboneInterface
    enabled = yes
    target_host = 45.39.190.201
    target_port = 4242
    transport_identity = 23ee01623eeb8653e5376a1d5d883798
    recursive_prs = no
    announces_from_internal = yes
    announces_to_internal = no
    name = gameboloto.fun
