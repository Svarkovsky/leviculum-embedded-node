#!/bin/sh

# ==============================================================================
ENABLED=yes
PROCS=socat
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TARGET_IP="192.168.5.100"
TARGET_PORT="7656"
LOCAL_PORT="7656"
PIDFILE="/var/run/socat_bridge.pid"
# ==============================================================================

start() {
    [ "$ENABLED" != "yes" ] && return
    
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "socat bridge loop is already running."
        return 0
    fi

    if netstat -an | grep -q ":${LOCAL_PORT}.*LISTEN"; then
        echo "socat bridge port ${LOCAL_PORT} is already busy by an external process."
        return 0
    fi

    echo "Starting resilient auto-restarting socat loop..."
    
    # 
    (
        while true; do
            socat TCP4-LISTEN:${LOCAL_PORT},reuseaddr,fork TCP4:${TARGET_IP}:${TARGET_PORT},connect-timeout=5
            sleep 1
        done
    ) </dev/null >/dev/null 2>&1 &
    
    echo $! > "$PIDFILE"
    echo "Done."
}

stop() {
    echo "Stopping socat loop and processes..."
    
    # 
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        kill -9 "$PID" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    
    #
    killall -9 socat 2>/dev/null
    echo "Done."
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "socat bridge is RUNNING."
        return 0
    else
        echo "socat bridge is STOPPED."
        return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) restart ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
